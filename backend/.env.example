# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SageMaker Configuration
SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name
SAGEMAKER_TIMEOUT=120
SAGEMAKER_MAX_RETRIES=3

# LLM Configuration
LLM_MODEL_TYPE=vllm
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.95

# Database Configuration (Aurora PostgreSQL)
DATABASE_HOST=your-aurora-endpoint.region.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=ravens_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here
DATABASE_SSL=true

# S3 Configuration
S3_BUCKET_NAME=ravens-rotowire-data
S3_REPORTS_PREFIX=reports/
S3_RAW_DATA_PREFIX=raw_data/
S3_EMBEDDINGS_PREFIX=embeddings/

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/aws/ecs/ravens-rotowire
CLOUDWATCH_LOG_STREAM=backend

# Vector Search Configuration
EMBEDDING_DIMENSION=1536

# VLLM Service URL(production)
VLLM_SERVICE_URL=http://localhost:8001