# LLM Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001

# vLLM Model Configuration
MODEL_NAME=meta-llama/Llama-2-7b-chat-hf
MODEL_REVISION=main
TENSOR_PARALLEL_SIZE=1
